    parts.push('<svg viewBox="'+CROP.x+' '+CROP.y+' '+CROP.w+' '+CROP.h+'" role="img" aria-label="Map of water-level change in the Ogallala Aquifer region since predevelopment, with the Texas Panhandle and South Plains extension districts and the six Kansas KFMA regions outlined">');
    parts.push('<defs>'+
      '<pattern id="stripesAB" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">'+
        '<rect width="10" height="10" fill="var(--accent-a)"></rect>'+
