<style>
:root{
  --bg:#F1F2ED;
  --surface:#FFFFFF;
  --surface-2:#F7F6F0;
  --border:#DEDBCE;
  --border-soft:#E9E6DA;
  --ink:#24221C;
  --ink-2:#56534A;
  --ink-mute:#8B8778;
  --accent-a:#0C8F76;
  --accent-a-soft:#E1F1EC;
  --accent-a-line:#B7DED2;
  --accent-b:#C88A2E;
  --accent-b-soft:#F8ECD7;
  --accent-b-line:#EAD1A0;
  --accent-c:#2E6E93;
  --accent-c-soft:#E2EDF3;
  --accent-c-line:#B9D3E1;
  --good:#2E8B57;
  --good-soft:#E4F2E9;
  --critical:#C24B3E;
  --critical-soft:#FBEAE7;
