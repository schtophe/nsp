  function ksCountyMatches(c, dist){
    if(!dist) return false;
    if(dist === 'Western') return c.western;
    return c.region === dist;
  }

  function updateMap(A,B){
    var selA = sideA.getSelection(), selB = sideB.getSelection();
    var farmA = sideA.isFarm(), farmB = sideB.isFarm();
    var clsA = farmA ? 'c' : 'a', clsB = farmB ? 'c' : 'b';
    var distA_tx = selA.state==='Texas' ? selA.district : null;
    var distB_tx = selB.state==='Texas' ? selB.district : null;
    var distA_ks = selA.state==='Kansas' ? selA.district : null;
    var distB_ks = selB.state==='Kansas' ? selB.district : null;

    var paths = document.querySelectorAll('#mapSvgCombined .map-county');
    Array.prototype.forEach.call(paths, function(p){
      p.classList.remove('hl-a','hl-b','hl-c','hl-both','hl-ac','hl-bc','hl-all','hl-western');
      var isA, isB;
      if(p.hasAttribute('data-dist')){
        var d = 'District '+p.getAttribute('data-dist');
        isA = d===distA_tx; isB = d===distB_tx;
      } else if(p.hasAttribute('data-region') || p.hasAttribute('data-western')){
        var c = {region:p.getAttribute('data-region'), western:p.getAttribute('data-western')==='1'};
        isA = ksCountyMatches(c, distA_ks); isB = ksCountyMatches(c, distB_ks);
        if((isA && distA_ks==='Western') || (isB && distB_ks==='Western')) p.classList.add('hl-western');
      } else {
        return;
      }
      if(isA && isB){
        // Overlap uses the striped pattern for whichever two colors are in play.
        var pairCls = [clsA, clsB].sort().join('');
        if(pairCls==='ab') p.classList.add('hl-both');
        else if(pairCls==='ac') p.classList.add('hl-ac');
        else if(pairCls==='bc') p.classList.add('hl-bc');
      }
      else if(isA) p.classList.add('hl-'+clsA);
      else if(isB) p.classList.add('hl-'+clsB);
    });

    document.getElementById('mapChipRowA').className = 'map-chip '+clsA;
    document.getElementById('mapChipRowB').className = 'map-chip '+clsB;
    document.getElementById('mapChipA').textContent = (farmA?'My Farm':'Budget A')+' \u00b7 '+selA.state+' \u00b7 '+selA.district;
    document.getElementById('mapChipASub').textContent = (DISTRICT_SHORT[selA.district]||selA.district)+' \u00b7 '+selA.crop+' \u00b7 '+selA.irrigation;
    document.getElementById('mapChipB').textContent = (farmB?'My Farm':'Budget B')+' \u00b7 '+selB.state+' \u00b7 '+selB.district;
    document.getElementById('mapChipBSub').textContent = (DISTRICT_SHORT[selB.district]||selB.district)+' \u00b7 '+selB.crop+' \u00b7 '+selB.irrigation;

    var noteEl = document.getElementById('mapNote');
    var notes = ["Texas regions mapped to Panhandle Extension District 1 (Amarillo) and South Plains Extension District 2 (Lubbock), by county. Kansas regions follow the Kansas Farm Management Association's six associations (K-State AgManager.info). Scoped regions overlap the Ogallala Aquifer \u2014 the water-stressed ground at the center of this project, displayed in light blue shading, from USGS Data Series 543 (the official aquifer-boundary dataset), simplified for display. Water-level change base map: NOAA Climate.gov, \u201cNational Climate Assessment: Great Plains\u2019 Ogallala Aquifer Drying Out\u201d (Feb. 2019), based on USGS Scientific Investigations Report 2017-5040 (McGuire, 2017)."];
    if(distA_ks==='Western' || distB_ks==='Western'){
      notes.push("\u201cWestern Kansas\u201d (used for durum wheat, irrigated wheat, and sorghum forage hay) isn't one of the six KFMA associations \u2014 it spans the state's western tier, so it's shown here as the combined Northwest + Southwest footprint (dashed outline).");
    }
    noteEl.textContent = notes.join(' ');
  }

  /* ---------- My Farm: calc engine, seeding, editing, save/load ---------- */
  function deepClone(o){ return JSON.parse(JSON.stringify(o)); }

  var IRRIGATION_COST_PREFIXES = ['energy cost','irrigation energy','irrigation labor'];

  // Recomputes every totals.* field from a My Farm budget's own sections —
  // the same routing rules build_data.py used (see route_total_label /
  // route_returns_label / irrigation_cost_labels) — so a live edit to any
  // item is reflected everywhere the dashboard reads budget.totals.
  // `fallbackAcreInches` supplies acreInches when no item carries an
  // AcreInch unit (the Kansas case, where it's a separate manual field).
  function computeTotals(sections, fallbackAcreInches){
    var byName = {};
    sections.forEach(function(s){ byName[s.name] = s; });
    function sumSec(name){
      var s = byName[name];
      if(!s) return null;
      var any = false, sum = 0;
      s.items.forEach(function(it){ if(it.total!=null){ sum += it.total; any = true; } });
      return any ? sum : null;
    }
    var totalRevenue = sumSec('REVENUE') || 0;
    var totalVariableCosts = sumSec('VARIABLE COSTS') || 0;
    var totalFixedCosts = sumSec('FIXED COSTS') || 0;
    var totalSpecifiedCosts = totalVariableCosts + totalFixedCosts;
    var returnsAboveVariableCosts = totalRevenue - totalVariableCosts;
    var returnsAboveSpecifiedCosts = totalRevenue - totalSpecifiedCosts;

    var acreInches = null, irrigationCost = null, aiItem = null;
    var vc = byName['VARIABLE COSTS'];
    if(vc){
      var irrSum = 0, irrAny = false;
      vc.items.forEach(function(it){
        var low = (it.label||'').toLowerCase();
        if(IRRIGATION_COST_PREFIXES.some(function(p){ return low.indexOf(p)===0; })){
          irrSum += (it.total||0); irrAny = true;
        }
        if(it.unit === 'AcreInch') aiItem = it;
      });
      irrigationCost = irrAny ? irrSum : null;
      acreInches = aiItem ? aiItem.qty : (fallbackAcreInches!=null ? fallbackAcreInches : null);
    } else if(fallbackAcreInches != null){
      acreInches = fallbackAcreInches;
    }

    var returnPerAcreInch = (acreInches && returnsAboveVariableCosts!=null) ? (returnsAboveVariableCosts/acreInches) : null;

    return {
      totalRevenue: totalRevenue, totalVariableCosts: totalVariableCosts, totalFixedCosts: totalFixedCosts,
      totalSpecifiedCosts: totalSpecifiedCosts, returnsAboveVariableCosts: returnsAboveVariableCosts,
      returnsAboveSpecifiedCosts: returnsAboveSpecifiedCosts, acreInches: acreInches,
      irrigationCost: irrigationCost, returnPerAcreInch: returnPerAcreInch, returnPerAcreInchSource: null
    };
  }

  var myFarm = null;       // the live, editable budget object
  var myFarmMeta = null;   // {revenueKey, aiKey, manualAcreInches}

  function itemKey(it){ return it.label+'|'+(it.group||''); }

  // Every crop in the dataset, regardless of which state(s) grow it — used
  // for My Farm's Crop dropdown so a crop that only exists in one state
  // (e.g. silage, only budgeted in Texas) still shows up when the farmer's
  // own state is set to the other one, rather than silently disappearing.
  function allCrops(){ return sortBy(uniq(KEYS.map(function(k){ return DATA[k].crop; })), CROP_ORDER); }
  function statesWithCrop(crop){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].crop===crop; }).map(function(k){ return DATA[k].state; })), STATE_ORDER);
  }
  function districtsWithCrop(crop, state){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].crop===crop && DATA[k].state===state; }).map(function(k){ return DATA[k].district; })), DISTRICT_ORDER);
  }
  function irrigationsWithCrop(crop, state, district){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].crop===crop && DATA[k].state===state && DATA[k].district===district; }).map(function(k){ return DATA[k].irrigation; })), IRR_ORDER);
  }
  function yearsWithCrop(crop, state, district, irrigation){
    return uniq(KEYS.filter(function(k){
      return DATA[k].crop===crop && DATA[k].state===state && DATA[k].district===district && DATA[k].irrigation===irrigation;
    }).map(function(k){ return DATA[k].year; })).sort(function(a,b){ return a-b; });
  }

  // Builds a fresh My Farm budget from the baseline the farm selector panel
  // currently points to, discarding any in-progress edits. Mirrors the
  // structure of a normal DATA[] budget (sections/totals) plus isCustom and
  // pointers to the yield/price item and, on Texas, the acre-inch item.
  function seedMyFarm(state, district, crop, irrigation, year){
    var base = DATA[keyFor(state, district, crop, irrigation, year)];
    if(!base) return null;
    var b = deepClone(base);
    b.sections.forEach(function(sec){
      sec.items = sec.items.filter(function(it){ return !/^Total /i.test(it.label) && !/^Returns?\s+Above/i.test(it.label); });
    });
    b.isCustom = true;
    b.baselineKey = keyFor(state, district, crop, irrigation, year);

    var revSec = b.sections.find(function(s){ return s.name==='REVENUE'; });
    var revItem = revSec && revSec.items.length ? revSec.items[0] : null;
    var vcSec = b.sections.find(function(s){ return s.name==='VARIABLE COSTS'; });
    var aiItem = vcSec ? vcSec.items.find(function(it){ return it.unit==='AcreInch'; }) : null;

    myFarmMeta = {
      revenueKey: revItem ? itemKey(revItem) : null,
      aiKey: aiItem ? itemKey(aiItem) : null,
      manualAcreInches: aiItem ? null : (base.totals.acreInches!=null ? base.totals.acreInches : null)
    };
    b.totals = computeTotals(b.sections, myFarmMeta.manualAcreInches);
    return b;
  }

  // Builds My Farm when the chosen crop has no budget at all for the
  // farmer's own state/district (e.g. Kansas has no silage budgets). The
  // dollar figures come entirely from a manually-picked source budget
  // (any state/district/irrigation/year that DOES grow this crop); the
  // farmer's own state/district are kept only as a display label — never
  // blended into the numbers — so the provenance stays honest.
  function seedMyFarmCrossRegion(displayState, displayDistrict, crop, srcState, srcDistrict, srcIrrigation, srcYear){
    var base = DATA[keyFor(srcState, srcDistrict, crop, srcIrrigation, srcYear)];
    if(!base) return null;
    var b = deepClone(base);
    b.sections.forEach(function(sec){
      sec.items = sec.items.filter(function(it){ return !/^Total /i.test(it.label) && !/^Returns?\s+Above/i.test(it.label); });
    });
    b.isCustom = true;
    b.crossRegion = true;
    b.baselineKey = keyFor(srcState, srcDistrict, crop, srcIrrigation, srcYear);
    b.sourceState = srcState; b.sourceDistrict = srcDistrict; b.sourceIrrigation = srcIrrigation; b.sourceYear = srcYear;
    b.state = displayState; b.district = displayDistrict; b.crop = crop; b.irrigation = srcIrrigation; b.year = srcYear;
    b.title = crop+' — '+displayDistrict+', '+displayState+' ('+srcIrrigation+')';
    b.subtitle = 'Custom budget — '+displayState+' has no '+crop+' data; costs are the '+srcState+' '+srcDistrict+' baseline, '+srcYear+'.';

    var revSec = b.sections.find(function(s){ return s.name==='REVENUE'; });
    var revItem = revSec && revSec.items.length ? revSec.items[0] : null;
    var vcSec = b.sections.find(function(s){ return s.name==='VARIABLE COSTS'; });
    var aiItem = vcSec ? vcSec.items.find(function(it){ return it.unit==='AcreInch'; }) : null;

    myFarmMeta = {
      revenueKey: revItem ? itemKey(revItem) : null,
      aiKey: aiItem ? itemKey(aiItem) : null,
      manualAcreInches: aiItem ? null : (base.totals.acreInches!=null ? base.totals.acreInches : null)
    };
    b.totals = computeTotals(b.sections, myFarmMeta.manualAcreInches);
    return b;
  }

  function findFarmItem(key){
    if(!myFarm) return null;
    for(var i=0;i<myFarm.sections.length;i++){
      var it = myFarm.sections[i].items.find(function(x){ return itemKey(x)===key; });
      if(it) return it;
    }
    return null;
  }

  function recomputeFarmTotals(){
    if(!myFarm) return;
    myFarm.totals = computeTotals(myFarm.sections, myFarmMeta.manualAcreInches);
  }

  function applyFarmItemEdit(key, newTotal){
    var it = findFarmItem(key);
    if(!it) return;
    it.total = newTotal;
    // Editing a total directly (rather than through qty/price) decouples
    // this row from its stored rate — clear qty/price so itemDetailLine
    // stops showing a now-inconsistent "qty @ price" sub-line.
    it.qty = null; it.price = null;
    recomputeFarmTotals();
    render();
  }

  function refreshFeaturedInputs(){
    var yieldEl = document.getElementById('farm-yield'), priceEl = document.getElementById('farm-price'),
      irrEl = document.getElementById('farm-irr-amt'),
      yieldUnitEl = document.getElementById('farmYieldUnit'), priceUnitEl = document.getElementById('farmPriceUnit');
    if(!myFarm || !myFarmMeta){
      yieldEl.value = ''; priceEl.value = ''; irrEl.value = '';
      yieldEl.disabled = priceEl.disabled = irrEl.disabled = true;
      yieldUnitEl.textContent = ''; priceUnitEl.textContent = '';
      return;
    }
    var revItem = myFarmMeta.revenueKey ? findFarmItem(myFarmMeta.revenueKey) : null;
    if(revItem){
      yieldEl.disabled = priceEl.disabled = false;
      yieldEl.value = revItem.qty!=null ? revItem.qty : '';
      priceEl.value = revItem.price!=null ? revItem.price : '';
      yieldUnitEl.textContent = revItem.unit ? '('+unitLabel(revItem.unit, revItem.qty, revItem.qty==null||Math.abs(revItem.qty-1)>=0.0005)+')' : '';
      priceUnitEl.textContent = revItem.unit ? '($/'+unitLabel(revItem.unit,1,false)+')' : '';
    } else {
      yieldEl.value = ''; priceEl.value = ''; yieldEl.disabled = priceEl.disabled = true;
      yieldUnitEl.textContent = ''; priceUnitEl.textContent = '';
    }
    var aiItem = myFarmMeta.aiKey ? findFarmItem(myFarmMeta.aiKey) : null;
    irrEl.disabled = false;
    irrEl.value = aiItem ? (aiItem.qty!=null?aiItem.qty:'') : (myFarmMeta.manualAcreInches!=null ? myFarmMeta.manualAcreInches : '');
  }

  function onFarmYieldOrPriceChange(){
    if(!myFarm || !myFarmMeta || !myFarmMeta.revenueKey) return;
    var it = findFarmItem(myFarmMeta.revenueKey);
    if(!it) return;
    var y = parseFloat(document.getElementById('farm-yield').value);
    var p = parseFloat(document.getElementById('farm-price').value);
    it.qty = isNaN(y) ? null : y;
    it.price = isNaN(p) ? null : p;
    it.total = (it.qty!=null && it.price!=null) ? it.qty*it.price : it.total;
    recomputeFarmTotals();
    render();
  }
  function onFarmIrrChange(){
    if(!myFarm || !myFarmMeta) return;
    var v = parseFloat(document.getElementById('farm-irr-amt').value);
    if(myFarmMeta.aiKey){
      var it = findFarmItem(myFarmMeta.aiKey);
      if(it){
        it.qty = isNaN(v) ? null : v;
        it.total = (it.qty!=null && it.price!=null) ? it.qty*it.price : it.total;
      }
    } else {
      myFarmMeta.manualAcreInches = isNaN(v) ? null : v;
    }
    recomputeFarmTotals();
    render();
  }

  function setFarmStatus(msg, cls){
    var el = document.getElementById('farmStatus');
    el.textContent = msg || '';
    el.className = 'farm-status'+(cls?' '+cls:'');
  }

  // Wires the ONE shared farm-extra control block (cost-baseline source
  // picker, featured Yield/Price/Irrigation inputs, Save/Load/Reset) —
  // it's relocated into whichever slot (A or B) is currently My Farm, and
  // these handlers always act on that active slot via slotsByPrefix.
  function wireFarmControls(){
    document.getElementById('farmUseSourceBtn').addEventListener('click', function(){
      var slot = slotsByPrefix[activeFarmPrefix];
      if(!slot) return;
      var displayState = slot.elS.value, displayDistrict = slot.elD.value, crop = slot.elC.value;
      var srcState = document.getElementById('farm-src-state').value,
        srcDistrict = document.getElementById('farm-src-district').value,
        srcIrr = document.getElementById('farm-src-irrigation').value,
        srcYear = document.getElementById('farm-src-year').value;
      if(!srcState || !srcDistrict || !srcIrr || !srcYear) return;
      myFarm = seedMyFarmCrossRegion(displayState, displayDistrict, crop, srcState, srcDistrict, srcIrr, srcYear);
      if(!myFarm){ setFarmStatus('Could not find that source budget.', 'err'); return; }
      setLockedSelect(slot.elI, srcIrr);
      setLockedSelect(slot.elY, String(srcYear));
      refreshFeaturedInputs();
      showFarmBadge('Cost baseline: '+srcState+' · '+srcDistrict+' · '+srcIrr+' · '+srcYear+' — not '+displayState+'-specific data.');
      setFarmStatus('Seeded '+crop+' for '+displayState+', '+displayDistrict+' from the '+srcState+' '+srcDistrict+' baseline.', 'ok');
      render();
    });

    document.getElementById('farm-yield').addEventListener('change', onFarmYieldOrPriceChange);
    document.getElementById('farm-price').addEventListener('change', onFarmYieldOrPriceChange);
    document.getElementById('farm-irr-amt').addEventListener('change', onFarmIrrChange);

    document.getElementById('farmResetBtn').addEventListener('click', function(){
      var slot = slotsByPrefix[activeFarmPrefix];
      if(!slot) return;
      if(myFarm && myFarm.crossRegion){
        myFarm = seedMyFarmCrossRegion(slot.elS.value, slot.elD.value, slot.elC.value, myFarm.sourceState, myFarm.sourceDistrict, myFarm.sourceIrrigation, myFarm.sourceYear);
        showFarmBadge('Cost baseline: '+myFarm.sourceState+' · '+myFarm.sourceDistrict+' · '+myFarm.sourceIrrigation+' · '+myFarm.sourceYear+' — not '+slot.elS.value+'-specific data.');
      } else {
        myFarm = seedMyFarm(slot.elS.value, slot.elD.value, slot.elC.value, slot.elI.value, slot.elY.value);
        hideFarmBadge();
      }
      refreshFeaturedInputs();
      setFarmStatus('Reset to baseline.', 'ok');
      render();
    });

    document.getElementById('farmSaveBtn').addEventListener('click', function(){
      if(!myFarm){ setFarmStatus('Nothing to save yet.', 'err'); return; }
      try{
        var payload = {
          schemaVersion: 1,
          activeScenario: 0,
          scenarios: [ myFarm ]
        };
        var blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        var fname = 'my-farm-'+(myFarm.state||'farm')+'-'+(myFarm.crop||'').replace(/[^a-z0-9]+/ig,'-')+'-'+(myFarm.year||'')+'.json';
        a.href = url; a.download = fname;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
        setFarmStatus('Saved '+fname, 'ok');
      } catch(err){
        setFarmStatus('Save failed: '+err.message, 'err');
      }
    });

    document.getElementById('farmLoadBtn').addEventListener('click', function(){
      document.getElementById('farmLoadFile').click();
    });
    document.getElementById('farmLoadFile').addEventListener('change', function(e){
      var file = e.target.files && e.target.files[0];
      if(!file) return;
      var reader = new FileReader();
      reader.onload = function(){
        try{
          var payload = JSON.parse(reader.result);
          var scen = payload && payload.scenarios && payload.scenarios[payload.activeScenario!=null?payload.activeScenario:0];
          if(!scen || !scen.sections || !scen.totals) throw new Error('Not a My Farm file');
          // A file can load even if neither slot is currently My Farm —
          // default it into slot A (its normal cascade seeds something
          // first, which we immediately overwrite with the loaded data).
          if(!activeFarmPrefix) slotsByPrefix.a.setMode('farm');
          var slot = slotsByPrefix[activeFarmPrefix];
          myFarm = scen;
          myFarm.isCustom = true;
          var revSec = myFarm.sections.find(function(s){ return s.name==='REVENUE'; });
          var revItem = revSec && revSec.items.length ? revSec.items[0] : null;
          var vcSec = myFarm.sections.find(function(s){ return s.name==='VARIABLE COSTS'; });
          var aiItem = vcSec ? vcSec.items.find(function(it){ return it.unit==='AcreInch'; }) : null;
          myFarmMeta = {
            revenueKey: revItem ? itemKey(revItem) : null,
            aiKey: aiItem ? itemKey(aiItem) : null,
            manualAcreInches: aiItem ? null : (myFarm.totals.acreInches!=null ? myFarm.totals.acreInches : null)
          };
          if(myFarm.state && states().indexOf(myFarm.state)!==-1){
            slot.elS.value = myFarm.state;
            fillSelect(slot.elD, districts(slot.elS.value));
            if(myFarm.district && districts(slot.elS.value).indexOf(myFarm.district)!==-1) slot.elD.value = myFarm.district;
            fillSelect(slot.elC, allCrops());
            if(myFarm.crop && allCrops().indexOf(myFarm.crop)!==-1) slot.elC.value = myFarm.crop;
            if(myFarm.crossRegion){
              showCropWarning(slot.elC.value+' isn’t in the dataset for '+slot.elS.value+', '+slot.elD.value+'. Manually pick a state/region below to use as the cost baseline — your farm will still be labeled '+slot.elS.value+', '+slot.elD.value+'.');
              populateSourcePicker(slot.elC.value);
              if(myFarm.sourceState && statesWithCrop(slot.elC.value).indexOf(myFarm.sourceState)!==-1){
                var srcS = document.getElementById('farm-src-state'), srcD = document.getElementById('farm-src-district'),
                  srcI = document.getElementById('farm-src-irrigation'), srcY = document.getElementById('farm-src-year');
                srcS.value = myFarm.sourceState;
                fillSelect(srcD, districtsWithCrop(slot.elC.value, srcS.value));
                if(myFarm.sourceDistrict) srcD.value = myFarm.sourceDistrict;
                fillSelect(srcI, irrigationsWithCrop(slot.elC.value, srcS.value, srcD.value));
                if(myFarm.sourceIrrigation) srcI.value = myFarm.sourceIrrigation;
                fillSelect(srcY, yearsWithCrop(slot.elC.value, srcS.value, srcD.value, srcI.value));
                if(myFarm.sourceYear) srcY.value = myFarm.sourceYear;
              }
              setLockedSelect(slot.elI, myFarm.irrigation);
              setLockedSelect(slot.elY, String(myFarm.year));
              showFarmBadge('Cost baseline: '+myFarm.sourceState+' · '+myFarm.sourceDistrict+' · '+myFarm.sourceIrrigation+' · '+myFarm.sourceYear+' — not '+myFarm.state+'-specific data.');
            } else {
              hideCropWarning();
              hideFarmBadge();
              fillSelect(slot.elI, irrigations(slot.elS.value, slot.elD.value, slot.elC.value));
              if(myFarm.irrigation && irrigations(slot.elS.value, slot.elD.value, slot.elC.value).indexOf(myFarm.irrigation)!==-1) slot.elI.value = myFarm.irrigation;
              slot.elI.disabled = false;
              fillSelect(slot.elY, years(slot.elS.value, slot.elD.value, slot.elC.value, slot.elI.value));
              if(myFarm.year && years(slot.elS.value, slot.elD.value, slot.elC.value, slot.elI.value).indexOf(myFarm.year)!==-1) slot.elY.value = myFarm.year;
              slot.elY.disabled = false;
            }
          }
          refreshFeaturedInputs();
          setFarmStatus('Loaded '+file.name, 'ok');
          render();
        } catch(err){
          setFarmStatus('Load failed: '+err.message, 'err');
        }
        document.getElementById('farmLoadFile').value = '';
      };
      reader.readAsText(file);
    });

    refreshFeaturedInputs();
  }

  var sideA, sideB;
  function render(){
    var A = sideA.get(), B = sideB.get();
    var farmA = sideA.isFarm(), farmB = sideB.isFarm();
    document.getElementById('titleA').textContent = A ? A.title : '—';
    document.getElementById('titleB').textContent = B ? B.title : '—';

    document.getElementById('legendSwatchA').style.background = farmA ? 'var(--accent-c)' : 'var(--accent-a)';
    document.getElementById('legendLabelA').textContent = farmA ? 'My Farm' : 'Budget A';
    document.getElementById('legendSwatchB').style.background = farmB ? 'var(--accent-c)' : 'var(--accent-b)';
    document.getElementById('legendLabelB').textContent = farmB ? 'My Farm' : 'Budget B';
    document.getElementById('tblHeadA').textContent = farmA ? 'My Farm' : 'Budget A';
    document.getElementById('tblHeadA').classList.toggle('farm-th', farmA);
    document.getElementById('tblHeadB').textContent = farmB ? 'My Farm' : 'Budget B';
    document.getElementById('tblHeadB').classList.toggle('farm-th', farmB);

    renderKpis(A,B);
    renderKeyFindings();
    renderTable(A,B);
    updateMap(A,B);
  }

  buildMap();
  sideA = makeSlot('a', {state:'Texas', district:'District 1', crop:'Sorghum (Grain)', irrigation:'Dryland', year:2026});
  sideB = makeSlot('b', {state:'Texas', district:'District 1', crop:'Corn (Grain)', irrigation:'Irrigated', year:2026});
  wireFarmControls();
  render();

  /* ---------- Crop comparison (grouped bar) ---------- */
  var tooltipEl = document.getElementById('kpiTooltip');
  function showTooltip(e, html){
    tooltipEl.innerHTML = html;
    tooltipEl.style.left = e.clientX+'px';
    tooltipEl.style.top = e.clientY+'px';
    tooltipEl.hidden = false;
  }
  function hideTooltip(){ tooltipEl.hidden = true; }
})();
</script>
