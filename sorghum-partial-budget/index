  --radius: 10px;
  --crop-corn-grain:#2A78D6;
  --crop-corn-silage:#EB6834;
  --crop-sorghum-grain:#1BAF7A;
  --crop-sorghum-silage:#EDA100;
  --crop-triticale:#E87BA4;
  --crop-wheat:#008300;
  --crop-durum:#4A3AA7;
  --crop-forage:#E34948;
  --aquifer-fill:#7EC8E3;
  --aquifer-line:#4A9BC7;
  --aquifer-label:#2E6E93;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#15181A;
    --surface:#1D2123;
    --surface-2:#23282A;
    --border:#343B3B;
    --border-soft:#2A302F;
    --ink:#ECEAE2;
    --ink-2:#B8B4A8;
    --ink-mute:#7D7A6F;
    --accent-a:#22AE8F;
    --accent-a-soft:rgba(34,174,143,0.14);
    --accent-a-line:rgba(34,174,143,0.4);
    --accent-b:#C79445;
    --accent-b-soft:rgba(199,148,69,0.16);
    --accent-b-line:rgba(199,148,69,0.42);
    --accent-c:#5FA9C9;
    --accent-c-soft:rgba(95,169,201,0.16);
    --accent-c-line:rgba(95,169,201,0.42);
    --good:#4CAF7D;
    --good-soft:rgba(76,175,125,0.14);
    --critical:#E07A6C;
    --critical-soft:rgba(224,122,108,0.14);
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.28);
    --crop-corn-grain:#3987E5;
    --crop-corn-silage:#D95926;
    --crop-sorghum-grain:#199E70;
    --crop-sorghum-silage:#C98500;
    --crop-triticale:#D55181;
    --crop-wheat:#008300;
    --crop-durum:#9085E9;
    --crop-forage:#E66767;
    --aquifer-fill:#5FA9C9;
    --aquifer-line:#8FCBE5;
    --aquifer-label:#8FCBE5;
  }
}
:root[data-theme="dark"]{
  --bg:#15181A;
  --surface:#1D2123;
  --surface-2:#23282A;
  --border:#343B3B;
  --border-soft:#2A302F;
  --ink:#ECEAE2;
  --ink-2:#B8B4A8;
  --ink-mute:#7D7A6F;
  --accent-a:#22AE8F;
  --accent-a-soft:rgba(34,174,143,0.14);
  --accent-a-line:rgba(34,174,143,0.4);
  --accent-b:#C79445;
  --accent-b-soft:rgba(199,148,69,0.16);
  --accent-b-line:rgba(199,148,69,0.42);
  --accent-c:#5FA9C9;
  --accent-c-soft:rgba(95,169,201,0.16);
  --accent-c-line:rgba(95,169,201,0.42);
  --good:#4CAF7D;
  --good-soft:rgba(76,175,125,0.14);
  --critical:#E07A6C;
  --critical-soft:rgba(224,122,108,0.14);
  --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.28);
  --crop-corn-grain:#3987E5;
  --crop-corn-silage:#D95926;
  --crop-sorghum-grain:#199E70;
  --crop-sorghum-silage:#C98500;
  --crop-triticale:#D55181;
  --crop-wheat:#008300;
  --crop-durum:#9085E9;
  --crop-forage:#E66767;
  --aquifer-fill:#5FA9C9;
  --aquifer-line:#8FCBE5;
  --aquifer-label:#8FCBE5;
}

*{box-sizing:border-box;}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:'Public Sans', ui-sans-serif, system-ui, sans-serif;
  padding:28px 20px 64px;
  -webkit-font-smoothing:antialiased;
}
.wrap{ max-width:1180px; margin:0 auto; }

/* ---------- Header ---------- */
header.page{ margin-bottom:28px; }
.brand-row{ display:flex; align-items:center; gap:14px; margin-bottom:20px; flex-wrap:wrap; }
.brand-chip{
  display:inline-flex; align-items:center;
  background:#ffffff;
  border:1px solid var(--border);
  border-radius:10px;
  padding:7px 12px;
}
.brand-chip img{ display:block; width:auto; }
.brand-chip.nsp img{ height:34px; }
.brand-chip.cal img{ height:26px; }
.brand-sep{ color:var(--ink-mute); font-size:13px; }
.subhead{
  font-family:'Fraunces', Georgia, serif;
  font-style:italic;
  font-weight:480;
  font-size:17px;
  color:var(--ink-2);
  margin:0 0 10px;
}
.eyebrow{
  font-family:'IBM Plex Mono', monospace;
  font-size:11.5px;
  letter-spacing:0.09em;
  text-transform:uppercase;
  color:var(--ink-mute);
  margin:0 0 8px;
}
h1{
  font-family:'Fraunces', Georgia, serif;
  font-weight:560;
  font-size:clamp(26px,3.4vw,36px);
  line-height:1.12;
  margin:0 0 8px;
  text-wrap:balance;
  letter-spacing:-0.01em;
}
.page-sub{
  color:var(--ink-2);
  font-size:14.5px;
  max-width:none;
  line-height:1.55;
  margin:0;
}
.src-link{ color:var(--accent-a); text-decoration:underline; text-decoration-color:var(--accent-a-line); text-underline-offset:2px; }
.src-link:hover{ text-decoration-color:var(--accent-a); }
.src-link:visited{ color:var(--accent-a); }
.byline{
  color:var(--ink-mute);
  font-size:12px;
  line-height:1.5;
  margin:10px 0 0;
}
.byline strong{ color:var(--ink-2); font-weight:600; }

/* ---------- Selector panels ---------- */
.selectors{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
  margin-bottom:22px;
  align-items:start;
}
@media (max-width:720px){ .selectors{ grid-template-columns:1fr; } }

.panel{
  background:var(--surface);
  border:1px solid var(--border-soft);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:18px 18px 16px;
  border-top:3px solid var(--panel-accent);
  position:relative;
}
.panel.a{ --panel-accent:var(--accent-a); }
.panel.b{ --panel-accent:var(--accent-b); }
.panel.farm-active{ --panel-accent:var(--accent-c); }
.mode-toggle{
  font-family:'Public Sans',sans-serif;
  font-size:10.5px; font-weight:800;
  letter-spacing:0.03em;
  color:var(--surface);
  background:var(--accent-c);
  border:1px solid var(--accent-c);
  border-radius:100px;
  padding:4px 10px;
  cursor:pointer;
  white-space:nowrap;
  box-shadow:0 1px 3px color-mix(in srgb, var(--accent-c) 45%, transparent);
}
.mode-toggle:hover{ filter:brightness(1.08); box-shadow:0 2px 5px color-mix(in srgb, var(--accent-c) 55%, transparent); }
.panel.farm-active .mode-toggle{ background:var(--ink); border-color:var(--ink); color:var(--surface); box-shadow:none; }
.panel.farm-active .mode-toggle:hover{ filter:brightness(1.15); }

.farm-featured{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(112px,1fr));
  gap:10px;
  margin-top:14px;
  padding-top:14px;
  border-top:1px dashed var(--border);
}
.unit-hint{ font-weight:500; text-transform:none; letter-spacing:0; color:var(--ink-mute); }
.field input[type="number"]{
  width:100%;
  background:var(--surface-2);
  color:var(--ink);
  border:1px solid var(--border);
  border-radius:7px;
  padding:9px 11px;
  font-family:'IBM Plex Mono',monospace;
  font-size:13.5px;
  font-weight:500;
  font-variant-numeric:tabular-nums;
}
.field input[type="number"]:focus-visible{ outline:2px solid var(--panel-accent); outline-offset:1px; }
.field input[type="number"]:disabled{ opacity:0.45; cursor:not-allowed; }
.farm-actions{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:14px; }
.farm-btn{
  font-family:'Public Sans',sans-serif;
  font-size:12px; font-weight:600;
  color:var(--surface);
  background:var(--panel-accent);
  border:1px solid var(--panel-accent);
  border-radius:100px;
  padding:7px 14px;
  cursor:pointer;
}
.farm-btn:hover{ filter:brightness(1.08); }
.farm-btn.ghost{ background:transparent; color:var(--ink-2); border-color:var(--border); }
.farm-btn.ghost:hover{ background:var(--surface-2); }
.farm-status{ font-size:11.5px; color:var(--ink-mute); }
.farm-status.ok{ color:var(--good); }
.farm-status.err{ color:var(--critical); }
.farm-note{ font-size:11.5px; color:var(--ink-mute); margin:8px 0 0; line-height:1.5; }
.farm-note.warn{ color:var(--critical); font-weight:600; margin:0 0 10px; }
.farm-cross-region{
  margin-top:14px;
  padding:12px 12px 14px;
  border-top:1px dashed var(--border);
  border-radius:8px;
  background:var(--critical-soft);
}
.farm-cross-region .field-grid{ margin-bottom:10px; }
.provenance-badge{
  margin-top:12px;
  font-size:11.5px;
  font-weight:600;
  color:var(--accent-c);
  background:var(--accent-c-soft);
  border:1px solid var(--accent-c-line);
  border-radius:8px;
  padding:7px 11px;
  line-height:1.5;
}

.panel-head{
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:14px;
}
.panel-chip{
  width:9px; height:9px; border-radius:50%;
  background:var(--panel-accent);
  flex:none;
}
.panel-label{
  font-family:'IBM Plex Mono',monospace;
  font-size:11.5px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--panel-accent);
  font-weight:600;
}
.panel-title{
  margin-left:auto;
  font-size:12.5px;
  color:var(--ink-mute);
  text-align:right;
  max-width:58%;
  line-height:1.35;
}

.field-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.field label{
  display:block;
  font-size:11px;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--ink-mute);
  margin-bottom:5px;
  font-weight:600;
}
select{
  width:100%;
  appearance:none;
  -webkit-appearance:none;
  background:var(--surface-2) url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8"><path d="M1 1l5 5 5-5" fill="none" stroke="%238B8778" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>') no-repeat right 11px center;
  color:var(--ink);
  border:1px solid var(--border);
  border-radius:7px;
  padding:9px 30px 9px 11px;
  font-family:'Public Sans',sans-serif;
  font-size:13.5px;
  font-weight:500;
  cursor:pointer;
}
select:focus-visible{ outline:2px solid var(--panel-accent); outline-offset:1px; }
select:disabled{ opacity:0.45; cursor:not-allowed; }

/* ---------- KPI strip ---------- */
.kpi-caption{ font-size:12px; color:var(--ink-mute); margin:0 0 8px; }
.kpi-caption strong{ color:var(--ink-2); font-weight:600; }
.kpi-strip{
  background:var(--surface);
  border:1px solid var(--border-soft);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:6px;
  margin-bottom:22px;
  overflow-x:auto;
}
.kpi-row{
  display:grid;
  grid-template-columns:repeat(7,minmax(132px,1fr));
  min-width:980px;
}
.kpi{
  padding:16px 14px;
  border-right:1px solid var(--border-soft);
}
.kpi:last-child{ border-right:none; }
.kpi-name{
  font-size:11px;
  letter-spacing:0.04em;
  text-transform:uppercase;
  color:var(--ink-mute);
  font-weight:600;
  margin-bottom:6px;
}
.kpi-chart{ margin-bottom:6px; }
.kpi-chart svg{ display:block; }
.kpi-bar-mark.a{ fill:var(--accent-a); }
.kpi-bar-mark.b{ fill:var(--accent-b); }
.kpi-bar-mark.c{ fill:var(--accent-c); }
.kpi-bar-label{ font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; font-size:11px; font-weight:600; fill:var(--ink); }
.kpi-delta{
  display:inline-flex; align-items:center; gap:4px;
  font-family:'IBM Plex Mono',monospace;
  font-size:12px; font-weight:600;
  padding:2px 7px;
  border-radius:100px;
}
.kpi-delta.pos{ color:var(--good); background:var(--good-soft); }
.kpi-delta.neg{ color:var(--critical); background:var(--critical-soft); }
.kpi-delta.flat{ color:var(--ink-mute); background:var(--surface-2); }
.kpi-emphasis{
  position:relative;
  background:color-mix(in srgb, var(--ink) 4.5%, var(--surface));
}
.kpi-emphasis::before{
  content:'';
  position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--accent-a),var(--accent-b));
}
.kpi-emphasis .kpi-name{ color:var(--ink); font-weight:700; }

/* ---------- Chart ---------- */
.card{
  background:var(--surface);
  border:1px solid var(--border-soft);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  padding:20px 20px 18px;
  margin-bottom:22px;
}
.card-head{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:6px; flex-wrap:wrap; }
.card-title{ font-family:'Fraunces',serif; font-weight:560; font-size:18px; }
.card-note{ font-size:12px; color:var(--ink-mute); }
.legend{ display:flex; gap:16px; margin:10px 0 16px; flex-wrap:wrap; }
.legend-item{ display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--ink-2); font-weight:500; }
.legend-swatch{ width:11px;height:11px;border-radius:3px; }

/* ---------- Table ---------- */
.tbl-wrap{ overflow-x:auto; }
table.compare{ width:100%; border-collapse:collapse; min-width:640px; font-size:13.5px; }
table.compare thead th{
  text-align:left;
  font-size:11px;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--ink-mute);
  font-weight:600;
  padding:8px 10px;
  border-bottom:1px solid var(--border);
  position:sticky; top:0; background:var(--surface);
}
table.compare thead th.num{ text-align:right; }
table.compare tbody td{ padding:7px 10px; border-bottom:1px solid var(--border-soft); vertical-align:top; }
table.compare tbody td.num{ text-align:right; font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; white-space:nowrap; }
table.compare tbody tr.item:hover td{ background:var(--surface-2); }
tr.section-row td{
  font-family:'IBM Plex Mono',monospace;
  font-size:11px;
  letter-spacing:0.07em;
  text-transform:uppercase;
  color:var(--ink);
  background:var(--surface-2);
  font-weight:600;
  padding-top:12px;
  padding-bottom:6px;
  border-top:1px solid var(--border);
}
tr.section-row:not(:first-child) td{ padding-top:22px; }
tr.total-row td{ font-weight:700; border-top:1px solid var(--border); background:var(--surface-2); padding-top:8px; padding-bottom:8px; }
tr.grand-total-row td{
  font-weight:700;
  border-top:2px solid var(--ink);
  background:color-mix(in srgb, var(--ink) 6%, var(--surface-2));
  padding-top:9px; padding-bottom:9px;
}
tr.total-row + tr.section-row td{ padding-top:22px; }
tr.return-row td.label{ font-style:italic; color:var(--ink-2); }
tr.return-row td.num.pos-amt{ color:var(--good); }
tr.return-row td.num.neg-amt{ color:var(--critical); }
tr.group-row td.label{ color:var(--ink-mute); font-size:11.5px; padding-top:10px; padding-bottom:2px; border-bottom:none; }
td.label{ color:var(--ink); }
td.label .grp{ display:block; font-size:11px; color:var(--ink-mute); font-weight:500; }
td.num .detail{ display:block; font-size:11px; color:var(--ink-mute); font-weight:500; font-family:'Public Sans',sans-serif; font-variant-numeric:normal; white-space:nowrap; margin-top:1px; }
.delta-chip{
  display:inline-block;
  font-size:11.5px;
  font-weight:600;
  padding:1px 6px;
  border-radius:100px;
}
.delta-chip.pos{ color:var(--good); background:var(--good-soft); }
.delta-chip.neg{ color:var(--critical); background:var(--critical-soft); }
.delta-chip.flat{ color:var(--ink-mute); }
.empty-cell{ color:var(--ink-mute); }
td.farm-cell{ background:color-mix(in srgb, var(--accent-c) 5%, transparent); }
td.farm-cell .farm-item-input{
  width:100%; max-width:120px;
  background:var(--surface);
  color:var(--ink);
  border:1px solid var(--border);
  border-radius:6px;
  padding:4px 6px;
  font-family:'IBM Plex Mono',monospace;
  font-size:13px; font-weight:600;
  font-variant-numeric:tabular-nums;
  text-align:right;
}
td.farm-cell .farm-item-input:focus-visible{ outline:2px solid var(--accent-c); outline-offset:1px; }
td.farm-cell .farm-item-input:disabled{ opacity:0.55; cursor:not-allowed; background:var(--surface-2); }
td.farm-cell .farm-linked-note{ display:block; font-size:10.5px; color:var(--ink-mute); margin-top:2px; }
th.farm-th{ color:var(--accent-c) !important; }

.foot-note{
  font-size:12px;
  color:var(--ink-mute);
  margin-top:26px;
  line-height:1.6;
  border-top:1px solid var(--border-soft);
  padding-top:16px;
}
.foot-note a{ color:var(--ink-2); }

.no-data{
  padding:40px 20px;
  text-align:center;
  color:var(--ink-mute);
  font-size:14px;
}

/* ---------- Key findings ---------- */
.findings-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}
@media (max-width:720px){ .findings-grid{ grid-template-columns:1fr; } }
.findings-label{
  font-family:'IBM Plex Mono',monospace;
  font-size:11.5px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  font-weight:600;
  margin-bottom:8px;
}
.findings-label.a{ color:var(--accent-a); }
.findings-label.b{ color:var(--accent-b); }
table.kf{ width:100%; border-collapse:collapse; font-size:12.5px; min-width:440px; }
table.kf thead th{
  text-align:right;
  font-size:10px;
  letter-spacing:0.03em;
  text-transform:uppercase;
  color:var(--ink-mute);
  font-weight:600;
  padding:6px 8px;
  border-bottom:1px solid var(--border);
  line-height:1.25;
}
table.kf thead th:first-child{ text-align:left; }
table.kf tbody td{ padding:7px 8px; border-bottom:1px solid var(--border-soft); text-align:right; font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; white-space:nowrap; }
table.kf tbody td:first-child{ text-align:left; font-family:'Public Sans',sans-serif; font-weight:600; white-space:normal; }
table.kf tbody tr.avg-row td{ background:var(--surface-2); font-weight:700; border-bottom:2px solid var(--border); }
table.kf tbody tr.peak td{ background:var(--good-soft); }
table.kf tbody tr.peak td:first-child::after{ content:"peak"; margin-left:6px; font-family:'IBM Plex Mono',monospace; font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--good); background:var(--surface); padding:1px 5px; border-radius:100px; }
.kf-delta{ display:block; font-size:10.5px; font-weight:600; margin-top:1px; }
.kf-delta.pos{ color:var(--good); }
.kf-delta.neg{ color:var(--critical); }
.kf-delta.flat{ color:var(--ink-mute); }
.kf-empty{ color:var(--ink-mute); }

.axis-label{ font-family:'IBM Plex Mono',monospace; font-size:9.5px; fill:var(--ink-mute); }
.cmp-tooltip{
  position:fixed;
  pointer-events:none;
  background:var(--ink);
  color:var(--bg);
  font-size:12px;
  line-height:1.4;
  padding:7px 10px;
  border-radius:7px;
  transform:translate(-50%,-125%);
  z-index:80;
  white-space:nowrap;
