        '<rect width="10" height="10" fill="var(--accent-a)"></rect>'+
        '<rect width="5" height="10" fill="var(--accent-c)"></rect>'+
      '</pattern>'+
      '<pattern id="stripesBC" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">'+
        '<rect width="10" height="10" fill="var(--accent-b)"></rect>'+
        '<rect width="5" height="10" fill="var(--accent-c)"></rect>'+
      '</pattern>'+
      '<pattern id="stripesABC" width="12" height="12" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">'+
        '<rect width="12" height="12" fill="var(--accent-a)"></rect>'+
        '<rect width="8" height="12" fill="var(--accent-b)"></rect>'+
        '<rect width="4" height="12" fill="var(--accent-c)"></rect>'+
