<script>
(function(){
  "use strict";
  var DATA = JSON.parse(document.getElementById('budget-data').textContent);
  var KEYS = Object.keys(DATA);

  var STATE_ORDER = ["Texas","Kansas"];
  var DISTRICT_ORDER = ["District 1","District 2","Northwest","Southwest","Northeast","South Central","Western"];
  var CROP_ORDER = ["Corn (Grain)","Corn (Silage)","Sorghum (Grain)","Sorghum (Silage)","Sorghum (Forage Hay)","Sorghum (Forage Silage)","Triticale (Silage)","Wheat","Durum Wheat"];
  var IRR_ORDER = ["Irrigated","Dryland"];
  var CROP_META = {
    "Corn (Grain)":          {colorVar:"--crop-corn-grain"},
    "Corn (Silage)":         {colorVar:"--crop-corn-silage"},
    "Sorghum (Grain)":       {colorVar:"--crop-sorghum-grain"},
    "Sorghum (Silage)":      {colorVar:"--crop-sorghum-silage"},
    "Sorghum (Forage Hay)":  {colorVar:"--crop-forage"},
    "Sorghum (Forage Silage)": {colorVar:"--crop-forage"},
    "Triticale (Silage)":   {colorVar:"--crop-triticale"},
    "Wheat":                {colorVar:"--crop-wheat"},
    "Durum Wheat":           {colorVar:"--crop-durum"}
  };

  function uniq(arr){ return arr.filter(function(v,i){ return arr.indexOf(v)===i; }); }
  function sortBy(arr, order){
    return arr.slice().sort(function(x,y){
      var ix=order.indexOf(x), iy=order.indexOf(y);
      if(ix===-1) ix=999; if(iy===-1) iy=999;
      return ix-iy;
    });
  }

  function states(){
    return sortBy(uniq(KEYS.map(function(k){ return DATA[k].state; })), STATE_ORDER);
  }
  function districts(state){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].state===state; })
      .map(function(k){ return DATA[k].district; })), DISTRICT_ORDER);
  }
  function crops(state, district){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].state===state && DATA[k].district===district; })
      .map(function(k){ return DATA[k].crop; })), CROP_ORDER);
  }
  function irrigations(state, district, crop){
    return sortBy(uniq(KEYS.filter(function(k){ return DATA[k].state===state && DATA[k].district===district && DATA[k].crop===crop; })
      .map(function(k){ return DATA[k].irrigation; })), IRR_ORDER);
  }
  function years(state, district, crop, irrigation){
    return uniq(KEYS.filter(function(k){
      return DATA[k].state===state && DATA[k].district===district && DATA[k].crop===crop && DATA[k].irrigation===irrigation;
    }).map(function(k){ return DATA[k].year; })).sort(function(a,b){return a-b;});
  }
  function keyFor(state, district, crop, irrigation, year){
    return state+"|"+district+"|"+crop+"|"+irrigation+"|"+year;
  }

  function fillSelect(sel, options, formatFn){
    var prev = sel.value;
    sel.innerHTML = "";
    options.forEach(function(o){
      var opt = document.createElement('option');
      opt.value = o;
      opt.textContent = formatFn ? formatFn(o) : o;
      sel.appendChild(opt);
    });
    // sel.value is always a string; options may be numbers (years) — compare
    // as strings so a previously-selected year (etc.) is actually preserved
    // instead of silently resetting to the first option on every cascade.
    if(options.some(function(o){ return String(o)===prev; })){ sel.value = prev; }
    return sel.value;
  }

  // Whichever slot (A or B) currently holds My Farm — only one at a time —
  // and the map from prefix -> its slot object, filled in once both exist,
  // so each slot's "swap to My Farm here" button can revert the other.
  var activeFarmPrefix = null;
  var slotsByPrefix = {};

  function hideFarmBadge(){
    var badge = document.getElementById('farmProvenanceBadge');
    badge.hidden = true; badge.textContent = '';
  }
  function showFarmBadge(text){
    var badge = document.getElementById('farmProvenanceBadge');
    badge.hidden = false; badge.textContent = text;
  }
  function hideCropWarning(){ document.getElementById('farmCropWarning').hidden = true; }
  function showCropWarning(text){
    document.getElementById('farmCropWarningText').textContent = text;
    document.getElementById('farmCropWarning').hidden = false;
  }
  function setLockedSelect(sel, value){
    sel.innerHTML = '';
    var opt = document.createElement('option');
    opt.value = value; opt.textContent = value;
    sel.appendChild(opt);
    sel.value = value;
    sel.disabled = true;
  }
  var srcListenersWired = false;
  function populateSourcePicker(crop){
    var srcS = document.getElementById('farm-src-state'), srcD = document.getElementById('farm-src-district'),
      srcI = document.getElementById('farm-src-irrigation'), srcY = document.getElementById('farm-src-year');
    function refillFromState(){
      var s = srcS.value;
      var d = fillSelect(srcD, districtsWithCrop(crop, s));
      var i = fillSelect(srcI, irrigationsWithCrop(crop, s, d));
      fillSelect(srcY, yearsWithCrop(crop, s, d, i));
    }
    function refillFromDistrict(){
      var s = srcS.value, d = srcD.value;
      var i = fillSelect(srcI, irrigationsWithCrop(crop, s, d));
      fillSelect(srcY, yearsWithCrop(crop, s, d, i));
    }
    function refillFromIrrigation(){
      fillSelect(srcY, yearsWithCrop(crop, srcS.value, srcD.value, srcI.value));
    }
    fillSelect(srcS, statesWithCrop(crop));
    refillFromState();
    if(!srcListenersWired){
      srcS.addEventListener('change', refillFromState);
      srcD.addEventListener('change', refillFromDistrict);
      srcI.addEventListener('change', refillFromIrrigation);
      srcListenersWired = true;
    }
  }

  // A slot is one of the two comparison panels (A or B). Each holds its own
  // State/District/Crop/Irrigation/Year selectors and normally resolves to
  // a fixed baseline budget from DATA — exactly the original two-panel
  // dashboard. Toggling "Use My Farm here" switches the SAME selectors into
  // My Farm's editable mode (sharing the one #farmExtra control block,
  // which JS relocates into whichever panel is active); toggling back
  // discards that slot's farm state and re-resolves the dropdowns as a
  // normal baseline budget. Only one slot can be My Farm at a time.
  function makeSlot(prefix, defaults){
    var elS = document.getElementById(prefix+'-state');
    var elD = document.getElementById(prefix+'-district');
    var elC = document.getElementById(prefix+'-crop');
    var elI = document.getElementById(prefix+'-irrigation');
    var elY = document.getElementById(prefix+'-year');
    var panelEl = document.getElementById('panel-'+prefix);
    var panelLabelEl = document.getElementById(prefix+'-panel-label');
    var farmSlotEl = document.getElementById(prefix+'-farm-slot');
    var toggleBtn = document.getElementById(prefix+'-mode-toggle');
    var baselineLabel = prefix==='a' ? 'Budget A' : 'Budget B';
    var mode = 'baseline';
    var initializing = true;

    // ---- baseline (fixed DATA[] budget) cascade ----
    function baselineCascadeFromState(){
      var s = elS.value;
      var d = fillSelect(elD, districts(s));
      var c = fillSelect(elC, crops(s,d));
      var i = fillSelect(elI, irrigations(s,d,c));
      fillSelect(elY, yearsWithAvg(s,d,c,i), formatYearOption);
      render();
    }
    function baselineCascadeFromDistrict(){
      var s = elS.value, d = elD.value;
      var c = fillSelect(elC, crops(s,d));
      var i = fillSelect(elI, irrigations(s,d,c));
      fillSelect(elY, yearsWithAvg(s,d,c,i), formatYearOption);
      render();
    }
    function baselineCascadeFromCrop(){
      var s = elS.value, d = elD.value, c = elC.value;
      var i = fillSelect(elI, irrigations(s,d,c));
      fillSelect(elY, yearsWithAvg(s,d,c,i), formatYearOption);
      render();
    }
    function baselineCascadeFromIrrigation(){
      var s = elS.value, d = elD.value, c = elC.value, i = elI.value;
      fillSelect(elY, yearsWithAvg(s,d,c,i), formatYearOption);
      render();
    }

    // ---- My Farm cascade (this slot only, while mode==='farm') ----
    function farmReseedNative(){
      if(initializing) return;
      myFarm = seedMyFarm(elS.value, elD.value, elC.value, elI.value, elY.value);
      refreshFeaturedInputs();
      hideFarmBadge();
      setFarmStatus('Loaded from '+elS.value+' · '+elD.value+' baseline.', 'ok');
      render();
    }
    function farmUpdateCropAvailability(){
      var s = elS.value, d = elD.value, c = elC.value;
      var avail = irrigations(s, d, c);
      if(avail.length){
        elI.disabled = false; elY.disabled = false;
        var i = fillSelect(elI, avail);
        fillSelect(elY, years(s, d, c, i));
        hideCropWarning();
        farmReseedNative();
      } else {
        elI.innerHTML = ''; elY.innerHTML = ''; elI.disabled = true; elY.disabled = true;
        showCropWarning(c+' isn’t in the dataset for '+s+', '+d+'. Manually pick a state/region below to use as the cost baseline — your farm will still be labeled '+s+', '+d+'.');
        populateSourcePicker(c);
        myFarm = null; myFarmMeta = null;
        hideFarmBadge();
        refreshFeaturedInputs();
        setFarmStatus('Pick a cost baseline below, then "Use this as my cost baseline."', '');
        render();
      }
    }
    function farmCascadeFromState(){
      fillSelect(elD, districts(elS.value));
      fillSelect(elC, allCrops());
      farmUpdateCropAvailability();
    }
    function farmCascadeFromDistrict(){
      fillSelect(elC, allCrops());
      farmUpdateCropAvailability();
    }
    function farmCascadeFromIrrigation(){
      fillSelect(elY, years(elS.value, elD.value, elC.value, elI.value));
      farmReseedNative();
    }

    // ---- dispatchers: same 5 elements serve both modes ----
    elS.addEventListener('change', function(){ mode==='baseline' ? baselineCascadeFromState() : farmCascadeFromState(); });
    elD.addEventListener('change', function(){ mode==='baseline' ? baselineCascadeFromDistrict() : farmCascadeFromDistrict(); });
    elC.addEventListener('change', function(){ mode==='baseline' ? baselineCascadeFromCrop() : farmUpdateCropAvailability(); });
    elI.addEventListener('change', function(){ mode==='baseline' ? baselineCascadeFromIrrigation() : farmCascadeFromIrrigation(); });
    elY.addEventListener('change', function(){ mode==='baseline' ? render() : farmReseedNative(); });

    function setMode(newMode){
      if(newMode===mode) return;
      mode = newMode;
      if(mode==='farm'){
        panelEl.classList.add('farm-active');
        panelLabelEl.textContent = 'My Farm';
        toggleBtn.textContent = 'Use a baseline budget here';
        var extra = document.getElementById('farmExtra');
        farmSlotEl.appendChild(extra);
        extra.hidden = false;
        activeFarmPrefix = prefix;
        fillSelect(elC, allCrops());
        farmUpdateCropAvailability();
      } else {
        panelEl.classList.remove('farm-active');
        panelLabelEl.textContent = baselineLabel;
        toggleBtn.textContent = 'Use My Farm here';
        document.getElementById('farmExtra').hidden = true;
        hideCropWarning();
        if(activeFarmPrefix===prefix) activeFarmPrefix = null;
        elI.disabled = false; elY.disabled = false;
        var s = elS.value, d = elD.value, c = fillSelect(elC, crops(s,d));
        var i = fillSelect(elI, irrigations(s,d,c));
        fillSelect(elY, yearsWithAvg(s,d,c,i), formatYearOption);
        render();
      }
    }

    toggleBtn.addEventListener('click', function(){
      if(mode==='baseline'){
        var otherPrefix = prefix==='a' ? 'b' : 'a';
        if(activeFarmPrefix===otherPrefix && slotsByPrefix[otherPrefix]) slotsByPrefix[otherPrefix].setMode('baseline');
        setMode('farm');
      } else {
        setMode('baseline');
      }
    });

    // init (always starts in baseline mode)
    var s0 = fillSelect(elS, states());
    if(defaults && defaults.state && states().indexOf(defaults.state)!==-1){ elS.value = defaults.state; s0 = elS.value; }
    var d0 = fillSelect(elD, districts(s0));
    if(defaults && defaults.district && districts(s0).indexOf(defaults.district)!==-1){ elD.value = defaults.district; d0 = elD.value; }
    var c0 = fillSelect(elC, crops(s0,d0));
    if(defaults && defaults.crop && crops(s0,d0).indexOf(defaults.crop)!==-1){ elC.value = defaults.crop; c0 = elC.value; }
    var i0 = fillSelect(elI, irrigations(s0,d0,c0));
    if(defaults && defaults.irrigation && irrigations(s0,d0,c0).indexOf(defaults.irrigation)!==-1){ elI.value = defaults.irrigation; i0 = elI.value; }
    var y0 = fillSelect(elY, yearsWithAvg(s0,d0,c0,i0), formatYearOption);
    if(defaults && defaults.year && yearsWithAvg(s0,d0,c0,i0).indexOf(defaults.year)!==-1){ elY.value = defaults.year; y0 = elY.value; }
    initializing = false;

    var slot = {
      get: function(){
        if(mode==='farm') return myFarm;
        if(elY.value === AVG_YEAR){
          return buildAverageBudget(elS.value, elD.value, elC.value, elI.value);
        }
        return DATA[keyFor(elS.value, elD.value, elC.value, elI.value, elY.value)];
      },
      getSelection: function(){
        return {state: elS.value, district: elD.value, crop: elC.value, irrigation: elI.value, year: elY.value};
      },
      isFarm: function(){ return mode==='farm'; },
      setMode: setMode,
      elS: elS, elD: elD, elC: elC, elI: elI, elY: elY
    };
    slotsByPrefix[prefix] = slot;
    return slot;
  }

  function yearSeries(state, district, crop, irrigation){
    return years(state,district,crop,irrigation).map(function(y){
      return DATA[keyFor(state,district,crop,irrigation,y)];
    });
  }

  var AVG_YEAR = '5yr-avg';
  function yearsWithAvg(state, district, crop, irrigation){
    var real = years(state, district, crop, irrigation);
    return real.length > 1 ? real.concat([AVG_YEAR]) : real;
  }
  function formatYearOption(y){
    return y === AVG_YEAR ? '5-Year Avg' : y;
  }

  // Synthesizes a virtual "5-Year Average" budget for one state/district/crop/
  // irrigation series. Every totals.* field is the simple mean of that field's
  // per-year value (never a ratio recomputed from other averages) so this
  // exactly matches the "5-yr avg." row already shown in Key Findings below —
  // same source years, same formula, per field.
  function buildAverageBudget(state, district, crop, irrigation){
    var series = yearSeries(state, district, crop, irrigation).filter(function(b){ return b; });
    if(!series.length) return null;
    var yrs = series.map(function(b){ return b.year; });
    var yrMin = Math.min.apply(null, yrs), yrMax = Math.max.apply(null, yrs);
    var yrLabel = yrMin===yrMax ? String(yrMin) : (yrMin+'–'+yrMax);

    function avgField(key){
      var vals = series.map(function(b){ return b.totals[key]; }).filter(function(v){ return v!=null; });
      if(!vals.length) return null;
      return vals.reduce(function(a,c){ return a+c; }, 0)/vals.length;
    }
    var totalsKeys = ['totalRevenue','totalVariableCosts','totalFixedCosts','returnsAboveVariableCosts',
      'totalSpecifiedCosts','returnsAboveSpecifiedCosts','acreInches','irrigationCost','returnPerAcreInch'];
    var totals = {};
    totalsKeys.forEach(function(k){ totals[k] = avgField(k); });
    totals.returnPerAcreInchSource = null;

    // Averaged line items: union of (section, label) across years; each item's
    // total is the mean of its own per-year total, over the years it appears in.
    var sectionOrder = [];
    var sectionMap = {};
    series.forEach(function(b){
      b.sections.forEach(function(sec){
        if(!(sec.name in sectionMap)){
          sectionMap[sec.name] = {items: [], itemIndex: {}};
          sectionOrder.push(sec.name);
        }
        var target = sectionMap[sec.name];
        sec.items.forEach(function(it){
          // Same label can recur within a section under different cost
          // groups (e.g. "Tractors/Self-Propelled" under Machinery Labor,
          // Diesel Fuel, and Repairs & Maintenance are three distinct
          // costs in different units) — key on label+group so they stay
          // separate rows instead of silently merging.
          var key = it.label+'|'+(it.group||'');
          if(!(key in target.itemIndex)){
            target.itemIndex[key] = target.items.length;
            target.items.push({label: it.label, group: it.group||null, unit: null,
              _sum:0, _count:0, _qtySum:0, _qtyCount:0, _priceSum:0, _priceCount:0});
          }
          var slot = target.items[target.itemIndex[key]];
          if(it.total != null){ slot._sum += it.total; slot._count += 1; }
          if(it.qty != null){ slot._qtySum += it.qty; slot._qtyCount += 1; }
          if(it.price != null){ slot._priceSum += it.price; slot._priceCount += 1; }
          if(!slot.group && it.group) slot.group = it.group;
          if(!slot.unit && it.unit) slot.unit = it.unit;
        });
      });
    });
    var sections = sectionOrder.map(function(name){
      var target = sectionMap[name];
      return {
        name: name,
        items: target.items.map(function(it){
          return {label: it.label, group: it.group,
            qty: it._qtyCount ? it._qtySum/it._qtyCount : null,
            unit: it.unit,
            price: it._priceCount ? it._priceSum/it._priceCount : null,
            total: it._count ? it._sum/it._count : null};
        })
      };
    });

    var last = series[series.length-1];
    return {
      state: state, district: district, crop: crop, irrigation: irrigation,
      year: '5-Year Avg',
      title: crop + ' — 5-Year Average (' + yrLabel + ')',
      subtitle: (last && last.subtitle ? last.subtitle.replace(/\b\d{4}\b/, yrLabel) : (state+' · '+district)) + ' — averaged across ' + series.length + ' years',
      sections: sections,
      totals: totals,
      isAverage: true
    };
  }

  var fmtMoney = function(n){
    if(n===null||n===undefined||isNaN(n)) return "—";
    var sign = n<0 ? "−" : "";
    return sign+"$"+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  };
  var fmtMoney0 = function(n){
    if(n===null||n===undefined||isNaN(n)) return "—";
    var sign = n<0 ? "−" : "";
    return sign+"$"+Math.abs(n).toLocaleString('en-US',{maximumFractionDigits:0});
  };
  var fmtInches = function(n){
    if(n===null||n===undefined||isNaN(n)) return '—';
    return n.toLocaleString('en-US',{maximumFractionDigits:1})+'"';
  };
  var fmtQty = function(n){
    if(n===null||n===undefined||isNaN(n)) return '—';
    return n.toLocaleString('en-US',{maximumFractionDigits:2});
  };
  // Source data mixes full unit names and farm-budget abbreviations across
  // states/crops (e.g. "Bushel" vs "bu", "CWT"). Map each to a clean
  // singular/plural pair for display; fall back to a simple "+s" pluralizer
  // for anything not covered.
  var UNIT_DISPLAY = {
    'Acre':{s:'Acre',p:'Acres'}, 'AcreInch':{s:'Acre-Inch',p:'Acre-Inches'},
    'Application':{s:'Application',p:'Applications'}, 'Bag':{s:'Bag',p:'Bags'},
    'Bushel':{s:'Bushel',p:'Bushels'}, 'bu':{s:'bu',p:'bu'},
    'CWT':{s:'cwt',p:'cwt'}, 'Gallon':{s:'Gallon',p:'Gallons'},
    'Hour':{s:'Hour',p:'Hours'}, 'Pound':{s:'Pound',p:'Pounds'},
    'Ton':{s:'Ton',p:'Tons'}, 'ton':{s:'ton',p:'tons'}
  };
  function unitLabel(unit, qty, plural){
    var d = UNIT_DISPLAY[unit];
    if(d) return plural ? d.p : d.s;
    if(!plural) return unit;
    return /[sx]$/i.test(unit) ? unit+'es' : unit+'s';
  }
  // "Yield/rate" sub-line shown under a $ total: qty + unit, and the $/unit
  // price, when the source item carries both (e.g. "225 Bushels @ $5.50/Bushel"
  // for a crop revenue line, or "140 Pounds @ $0.41/Pound" for an input).
  // Acre-flat cost lines (unit "Acre") and Total/Returns rows carry no
  // meaningful qty/price and are skipped.
  function itemDetailLine(it){
    if(!it || it.unit==null || it.unit==='Acre') return '';
    var isPlural = it.qty==null || Math.abs(it.qty-1)>=0.0005;
    var parts = [];
    if(it.qty!=null) parts.push(fmtQty(it.qty)+' '+unitLabel(it.unit, it.qty, isPlural));
    if(it.price!=null) parts.push('@ '+fmtMoney(it.price)+'/'+unitLabel(it.unit, 1, false));
    return parts.join(' ');
  }

  var KPI_DEFS = [
    {name:'Total Revenue', get:function(b){return b.totals.totalRevenue;}, invert:false, fmt:fmtMoney0},
    {name:'Variable Costs', get:function(b){return b.totals.totalVariableCosts;}, invert:true, fmt:fmtMoney0},
    {name:'Fixed Costs', get:function(b){return b.totals.totalFixedCosts;}, invert:true, fmt:fmtMoney0},
    {name:'Returns Above Var. Costs', get:function(b){return b.totals.returnsAboveVariableCosts;}, invert:false, fmt:fmtMoney0, emphasize:true},
    {name:'Returns Above Spec. Costs', get:function(b){return b.totals.returnsAboveSpecifiedCosts;}, invert:false, fmt:fmtMoney0},
    {name:'Acre-Inches Applied', get:function(b){return b.totals.acreInches;}, invert:true, fmt:fmtInches},
    {name:'Return per Acre-Inch', get:function(b){return b.totals.returnPerAcreInch;}, invert:false, fmt:fmtMoney, emphasize:true}
  ];

  function fmtPct(p){
    return (p>0?'+':(p<0?'−':''))+Math.abs(p).toLocaleString('en-US',{maximumFractionDigits:0})+'%';
  }
  function deltaChipFmt(a,b,el,invert,fmt){
    var d = (b==null||a==null) ? null : b-a;
    if(d===null){ el.className='kpi-delta flat'; el.textContent='n/a'; return; }
    var good = invert ? d<0 : d>0;
    el.className = 'kpi-delta ' + (Math.abs(d)<0.005 ? 'flat' : (good?'pos':'neg'));
    var arrow = d>0.005 ? '↑' : (d<-0.005 ? '↓' : '–');
    // % change is relative to Budget A (the "from" side); omitted when A is
    // ~0, since a percent change off a near-zero base is not meaningful.
    var pctTxt = Math.abs(a) > 0.005 ? ' · '+fmtPct((d/Math.abs(a))*100) : '';
    el.textContent = arrow+' '+fmt(Math.abs(d))+pctTxt;
  }

  function buildKpiBarSVG(va, vb, fmt, clsA, clsB){
    var W = 128, H = 96;
    var padTop = 16, padBottom = 20;
    var plotH = H - padTop - padBottom;
    var vals = [va, vb].filter(function(v){ return v!=null; });
    if(!vals.length){
      return '<svg viewBox="0 0 '+W+' '+H+'" width="'+W+'" height="'+H+'"><text x="'+(W/2)+'" y="'+(H/2)+'" text-anchor="middle" class="axis-label">No data</text></svg>';
    }
    var maxV = Math.max(0, Math.max.apply(null, vals));
    var minV = Math.min(0, Math.min.apply(null, vals));
    var range = (maxV-minV) || Math.abs(maxV) || 1;
    function yFor(v){ return padTop + plotH*(1-(v-minV)/range); }
    var zeroY = yFor(0);
    var barW = 30, gap = 18;
    var groupW = barW*2+gap;
    var startX = (W-groupW)/2;
    var bars = [[va,clsA,startX], [vb,clsB,startX+barW+gap]];
    var svg = [];
    svg.push('<svg viewBox="0 0 '+W+' '+H+'" width="'+W+'" height="'+H+'" role="img" aria-label="Budget A vs Budget B">');
    svg.push('<line x1="4" y1="'+zeroY+'" x2="'+(W-4)+'" y2="'+zeroY+'" stroke="var(--border)" stroke-width="1"/>');
    bars.forEach(function(pair){
      var v = pair[0], cls = pair[1], bx = pair[2];
      if(v==null) return;
      var y1 = yFor(Math.max(v,0)), y2 = yFor(Math.min(v,0));
      var h = Math.max(1, y2-y1);
      var labelY = v>=0 ? (y1-5) : (y2+13);
      svg.push('<rect class="kpi-bar-mark '+cls+'" x="'+bx+'" y="'+y1+'" width="'+barW+'" height="'+h+'" rx="3" data-val="'+v+'" data-side="'+cls+'"></rect>');
      svg.push('<text x="'+(bx+barW/2)+'" y="'+labelY+'" text-anchor="middle" class="kpi-bar-label">'+fmt(v)+'</text>');
    });
    svg.push('</svg>');
    return svg.join('');
  }

  var KPI_SIDE_NAME = {a:'Budget A', b:'Budget B', c:'My Farm'};
  function renderKpis(A,B){
    var row = document.getElementById('kpiRow');
    row.innerHTML = '';
    var clsA = sideA.isFarm() ? 'c' : 'a', clsB = sideB.isFarm() ? 'c' : 'b';
    KPI_DEFS.forEach(function(def){
      var va = A?def.get(A):null, vb = B?def.get(B):null;
      var kpi = document.createElement('div'); kpi.className='kpi'+(def.emphasize?' kpi-emphasis':'');
      var name = document.createElement('div'); name.className='kpi-name'; name.textContent = def.name;
      var chartWrap = document.createElement('div'); chartWrap.className='kpi-chart';
      chartWrap.innerHTML = buildKpiBarSVG(va, vb, def.fmt, clsA, clsB);
      var chip = document.createElement('span');
      deltaChipFmt(va,vb,chip, def.invert, def.fmt);
      kpi.appendChild(name); kpi.appendChild(chartWrap); kpi.appendChild(chip);
      row.appendChild(kpi);

      Array.prototype.forEach.call(chartWrap.querySelectorAll('.kpi-bar-mark'), function(rect){
        rect.addEventListener('mousemove', function(e){
          var side = KPI_SIDE_NAME[rect.getAttribute('data-side')] || '';
          var val = parseFloat(rect.getAttribute('data-val'));
          showTooltip(e, '<strong>'+side+'</strong><br>'+def.name+': '+def.fmt(val));
        });
        rect.addEventListener('mouseleave', hideTooltip);
      });
    });
  }

  function labelFor(budget){
    if(!budget) return '—';
    return budget.state+' · '+budget.district+' · '+budget.crop+' · '+budget.irrigation+' · '+budget.year;
  }

  function renderKfTable(tableId, labelId, selection){
    var tbody = document.querySelector('#'+tableId+' tbody');
    var labelEl = document.getElementById(labelId);
    tbody.innerHTML = '';
    if(!selection){ labelEl.textContent = '—'; return; }
    labelEl.textContent = selection.state+' · '+selection.district+' · '+selection.crop+' · '+selection.irrigation;
    var series = yearSeries(selection.state, selection.district, selection.crop, selection.irrigation);
    if(!series.length){ tbody.innerHTML = '<tr><td colspan="5" class="kf-empty">No data</td></tr>'; return; }

    var rows = series.map(function(b){
      return {
        year: b.year,
        rav: b.totals.returnsAboveVariableCosts,
        ai: b.totals.acreInches,
        irr: b.totals.irrigationCost,
        rpi: b.totals.returnPerAcreInch
      };
    });
    var peakRav = Math.max.apply(null, rows.map(function(r){ return r.rav==null?-Infinity:r.rav; }));

    function avgOf(key){
      var vals = rows.map(function(r){ return r[key]; }).filter(function(v){ return v!=null; });
      if(!vals.length) return null;
      return vals.reduce(function(a,b){ return a+b; },0)/vals.length;
    }
    var avgRow = { rav: avgOf('rav'), ai: avgOf('ai'), irr: avgOf('irr'), rpi: avgOf('rpi') };
    var yrLabel = rows.length>1 ? (rows[0].year+'–'+rows[rows.length-1].year) : (rows[0]?rows[0].year:'');
    var avgTr = document.createElement('tr'); avgTr.className='avg-row';
    avgTr.innerHTML =
      '<td>'+yrLabel+' avg.</td>'+
      '<td>'+(avgRow.rav==null?'<span class="kf-empty">—</span>':fmtMoney0(avgRow.rav))+'</td>'+
      '<td>'+(avgRow.ai==null?'<span class="kf-empty">—</span>':fmtInches(avgRow.ai))+'</td>'+
      '<td>'+(avgRow.irr==null?'<span class="kf-empty">—</span>':fmtMoney0(avgRow.irr))+'</td>'+
      '<td>'+(avgRow.rpi==null?'<span class="kf-empty">—</span>':fmtMoney(avgRow.rpi))+'</td>';
    tbody.appendChild(avgTr);

    function deltaSpan(curr, prev, fmtFn, mode){
      if(prev==null || curr==null) return '';
      var d = curr-prev;
      if(Math.abs(d) < 0.005) return '<span class="kf-delta flat">– no change</span>';
      var cls;
      if(mode==='neutral'){ cls = 'flat'; }
      else{
        var good = mode==='invert' ? d<0 : d>0;
        cls = good ? 'pos' : 'neg';
      }
      var arrow = d>0 ? '↑' : '↓';
      return '<span class="kf-delta '+cls+'">'+arrow+' '+fmtFn(Math.abs(d))+' yr/yr</span>';
    }

    rows.forEach(function(r, idx){
      var prev = idx>0 ? rows[idx-1] : null;
      var tr = document.createElement('tr');
      if(r.rav===peakRav && r.rav!=null) tr.className='peak';
      var cells = [];
      cells.push('<td>'+r.year+'</td>');
      cells.push('<td>'+(r.rav==null?'<span class="kf-empty">—</span>':fmtMoney0(r.rav)+deltaSpan(r.rav, prev&&prev.rav, fmtMoney0, 'normal'))+'</td>');
      cells.push('<td>'+(r.ai==null?'<span class="kf-empty">—</span>':fmtInches(r.ai)+deltaSpan(r.ai, prev&&prev.ai, fmtInches, 'neutral'))+'</td>');
      cells.push('<td>'+(r.irr==null?'<span class="kf-empty">—</span>':fmtMoney0(r.irr)+deltaSpan(r.irr, prev&&prev.irr, fmtMoney0, 'invert'))+'</td>');
      cells.push('<td>'+(r.rpi==null?'<span class="kf-empty">—</span>':fmtMoney(r.rpi)+deltaSpan(r.rpi, prev&&prev.rpi, fmtMoney, 'normal'))+'</td>');
      tr.innerHTML = cells.join('');
      tbody.appendChild(tr);
    });
  }

  function renderKeyFindings(){
    renderKfTable('kfTableA','kfLabelA', sideA.getSelection());
    renderKfTable('kfTableB','kfLabelB', sideB.getSelection());
  }

  function renderTable(A,B){
    var tbody = document.getElementById('tblBody');
    tbody.innerHTML = '';
    var note = document.getElementById('tblNote');
    if(!A || !B){
      tbody.innerHTML = '<tr><td colspan="4" class="no-data">Select both budgets above.</td></tr>';
      note.textContent = '';
      return;
    }
    var farmA = sideA.isFarm(), farmB = sideB.isFarm();
    note.textContent = labelFor(A)+'  vs.  '+labelFor(B)+(farmA||farmB ? '  ·  My Farm is column '+(farmA?'A':'B') : '');

    function deltaCellHtml(va, vb){
      if(va==null || vb==null) return '<span class="delta-chip flat">n/a</span>';
      var d = vb-va;
      var cls = Math.abs(d)<0.005 ? 'flat' : (d>0?'pos':'neg');
      var arrow = d>0.005?'↑':(d<-0.005?'↓':'–');
      return '<span class="delta-chip '+cls+'">'+arrow+' '+fmtMoney(Math.abs(d))+'</span>';
    }

    // Renders one A/B cell: a plain figure for a baseline budget, or an
    // editable input (or a "linked" read-only note) for whichever side is
    // currently in My Farm mode.
    function renderSideCell(td, it, val, isFarmSide, key, isReturn){
      if(isFarmSide){
        td.className = 'num farm-cell';
        if(!it){ td.className += ' empty-cell'; td.textContent = '—'; return; }
        var linked = myFarmMeta && (key===myFarmMeta.revenueKey || key===myFarmMeta.aiKey);
        if(linked){
          var detail = itemDetailLine(it);
          td.innerHTML = fmtMoney(it.total) + (detail ? '<span class="detail">'+detail+'</span>' : '') +
            '<span class="farm-linked-note">edit via '+(key===myFarmMeta.revenueKey ? 'Yield/Price' : 'Irrigation')+' above</span>';
        } else {
          td.innerHTML = '<input type="number" class="farm-item-input" step="any" data-key="'+key.replace(/"/g,'&quot;')+'" value="'+(it.total==null?'':it.total.toFixed(2))+'">';
        }
      } else {
        td.className = 'num'+(val==null?' empty-cell':'')+(isReturn?signClass(val):'');
        var detail2 = itemDetailLine(it);
        td.innerHTML = (val==null ? '—' : fmtMoney(val)) + (detail2 ? '<span class="detail">'+detail2+'</span>' : '');
      }
    }

    // A bold, section-ending total row sourced directly from budget.totals
    // (the same numbers driving the KPI strip and Key Findings above) —
    // not re-summed from the displayed item rows — so it's always right
    // even when a section's item set differs between Budget A and B.
    function signClass(v){ return v==null ? '' : (v<-0.005 ? ' neg-amt' : (v>0.005 ? ' pos-amt' : '')); }
    function appendTotalRow(label, va, vb, extraClass){
      var isReturn = /(^|\s)return-row(\s|$)/.test(extraClass||'');
      var tr = document.createElement('tr'); tr.className = 'total-row'+(extraClass?' '+extraClass:'');
      var tdLabel = document.createElement('td'); tdLabel.className='label'; tdLabel.textContent = label;
      var tdA = document.createElement('td'); tdA.className='num'+(va==null?' empty-cell':'')+(isReturn?signClass(va):'');
      tdA.textContent = va==null ? '—' : fmtMoney(va);
      var tdB = document.createElement('td'); tdB.className='num'+(vb==null?' empty-cell':'')+(isReturn?signClass(vb):'');
      tdB.textContent = vb==null ? '—' : fmtMoney(vb);
      var tdD = document.createElement('td'); tdD.className='num'; tdD.innerHTML = deltaCellHtml(va,vb);
      tr.appendChild(tdLabel); tr.appendChild(tdA); tr.appendChild(tdB); tr.appendChild(tdD);
      tbody.appendChild(tr);
    }

    var SECTIONS = [
      {name:'REVENUE', totalLabel:'Total Revenue', totalsKey:'totalRevenue'},
      {name:'VARIABLE COSTS', totalLabel:'Total Variable Costs', totalsKey:'totalVariableCosts',
        returnLabel:'Return Above Variable Costs', returnsKey:'returnsAboveVariableCosts'},
      {name:'FIXED COSTS', totalLabel:'Total Fixed Costs', totalsKey:'totalFixedCosts'}
    ];

    SECTIONS.forEach(function(secDef){
      var secName = secDef.name;
      var secA = A.sections.find(function(s){return s.name===secName;});
      var secB = B.sections.find(function(s){return s.name===secName;});
      if(!secA && !secB) return;

      var sr = document.createElement('tr'); sr.className='section-row';
      var td = document.createElement('td'); td.colSpan=4; td.textContent = secName;
      sr.appendChild(td); tbody.appendChild(sr);

      // Real line items only (never a source "Total ..." row) — keyed on
      // label+group so the same equipment/input billed under different
      // cost groups (labor, fuel, repairs, etc.) stays on separate rows
      // instead of one silently overwriting another. Both budgets' items
      // are always included, in the order each first appears.
      function realItems(sec){
        return sec ? sec.items.filter(function(it){ return !/^Total /i.test(it.label); }) : [];
      }
      var itemsA = realItems(secA), itemsB = realItems(secB);
      var keys = [];
      var byKey = {};
      itemsA.concat(itemsB).forEach(function(it){
        var key = it.label+'|'+(it.group||'');
        if(!(key in byKey)){ byKey[key] = {label: it.label}; keys.push(key); }
      });
      function findIn(items, key){
        return items.find(function(it){ return (it.label+'|'+(it.group||''))===key; });
      }

      keys.forEach(function(key){
        var itA = findIn(itemsA, key);
        var itB = findIn(itemsB, key);
        var label = (itA||itB).label;
        var tr = document.createElement('tr'); tr.className = 'item';

        var tdLabel = document.createElement('td'); tdLabel.className='label';
        var grpTxt = (itA&&itA.group) || (itB&&itB.group) || '';
        tdLabel.innerHTML = label + (grpTxt ? '<span class="grp">'+grpTxt+'</span>' : '');
        tr.appendChild(tdLabel);

        var va = itA ? itA.total : null;
        var vb = itB ? itB.total : null;
        var tdA = document.createElement('td');
        renderSideCell(tdA, itA, va, farmA, key, false);
        var tdB = document.createElement('td');
        renderSideCell(tdB, itB, vb, farmB, key, false);
        tr.appendChild(tdA); tr.appendChild(tdB);

        var tdD = document.createElement('td'); tdD.className='num';
        tdD.innerHTML = deltaCellHtml(va, vb);
        tr.appendChild(tdD);
        tbody.appendChild(tr);
      });

      appendTotalRow(secDef.totalLabel, A.totals[secDef.totalsKey], B.totals[secDef.totalsKey]);
      if(secDef.returnLabel){
        appendTotalRow(secDef.returnLabel, A.totals[secDef.returnsKey], B.totals[secDef.returnsKey], 'return-row');
      }
    });

    // Total Costs = Variable + Fixed, following the last subsection total.
    appendTotalRow('Total Costs', A.totals.totalSpecifiedCosts, B.totals.totalSpecifiedCosts, 'grand-total-row');
    // Net return after all costs (revenue − total costs) — same field as
    // "Returns Above Spec. Costs" in the KPI strip / Key Findings above,
    // relabeled here to match this table's "Total Costs" terminology.
    appendTotalRow('Return Above Total Costs', A.totals.returnsAboveSpecifiedCosts, B.totals.returnsAboveSpecifiedCosts, 'return-row grand-total-row');

    // Wire up My Farm's editable item-total inputs (delegated per render),
    // whichever column (A or B) it currently occupies.
    if(farmA || farmB){
      Array.prototype.forEach.call(tbody.querySelectorAll('.farm-item-input'), function(inp){
        inp.addEventListener('change', function(){
          var key = inp.getAttribute('data-key');
          var v = parseFloat(inp.value);
          if(isNaN(v)) v = 0;
          applyFarmItemEdit(key, v);
        });
      });
    }
  }

  var DISTRICT_SHORT = {'District 1':'Panhandle','District 2':'South Plains',
    'Northwest':'Northwest KS','Southwest':'Southwest KS','Northeast':'Northeast KS',
    'South Central':'South Central KS','Western':'Western KS'};

  function buildMap(){
