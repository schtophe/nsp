    parts.push('<image class="map-stress-img" href="data:image/png;base64," x="145.07" y="-21.97" width="650.75" height="842.35" preserveAspectRatio="none"></image>');
    // These eight regions are traced directly against this raster's own
    // state-border lines (found by scanning the image for the border/
